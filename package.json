{
  "name": "hermes-scout",
  "version": "0.1.0",
  "private": true,
  "description": "Innovera AI Opportunity Radar — always-on research agent (Hermes Scout)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src trigger scripts",
    "dev": "node --env-file=.env ./node_modules/trigger.dev/dist/esm/index.js dev",
    "trigger:dev": "node --env-file=.env ./node_modules/trigger.dev/dist/esm/index.js dev",
    "trigger:deploy": "node --env-file=.env ./node_modules/trigger.dev/dist/esm/index.js deploy",
    "db:migrate": "insforge db migrations up --all",
    "db:migrations": "insforge db migrations list",
    "functions:deploy": "insforge functions deploy feedback --file functions/feedback.ts --name \"Scout Feedback\"",
    "scout:dry-run": "node --import tsx scripts/dry-run.ts",
    "scout:run": "node --import tsx scripts/run-scan.ts",
    "scout:list": "node --import tsx scripts/list-opportunities.ts",
    "scout:report": "node --import tsx scripts/generate-report.ts"
  },
  "dependencies": {
    "@insforge/sdk": "^1.3.1",
    "@notionhq/client": "^2.3.0",
    "@trigger.dev/sdk": "4.4.6",
    "fast-xml-parser": "^4.5.0",
    "resend": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "trigger.dev": "4.4.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed"
}
